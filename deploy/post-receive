#!/usr/bin/env bash
# Git-хук деплоя. Срабатывает на `git push production main`:
# раскладывает код, ставит зависимости, собирает админку и сайт, перезапускает сервис.
#
# Ставится на сервер скриптом deploy/provision.sh в /srv/pro-comfort/repo.git/hooks/.
set -euo pipefail

ROOT="/srv/pro-comfort"
APP="$ROOT/app"

# Настройки сервиса нужны и сборке (адрес API), и сиду (путь к базе).
set -a
# shellcheck disable=SC1091
. "$ROOT/env"
set +a

DOMAIN="${SITE_DOMAIN:-pro-comfort.pro}"

while read -r _old _new ref; do
  if [ "$ref" != "refs/heads/main" ]; then
    echo "  ветка $ref пропущена — деплоится только main"
    continue
  fi

  echo "--- Раскладываем код"
  git --work-tree="$APP" --git-dir="$ROOT/repo.git" checkout -f main

  # Хук обновляет сам себя из репозитория. Пишем через временный файл и rename:
  # запущенный bash продолжает читать старый inode, новая версия применится
  # со следующего пуша.
  if ! cmp -s "$APP/deploy/post-receive" "$ROOT/repo.git/hooks/post-receive"; then
    cp "$APP/deploy/post-receive" "$ROOT/repo.git/hooks/post-receive.new"
    chmod 755 "$ROOT/repo.git/hooks/post-receive.new"
    mv -f "$ROOT/repo.git/hooks/post-receive.new" "$ROOT/repo.git/hooks/post-receive"
    echo "    хук деплоя обновлён — применится со следующего пуша"
  fi

  cd "$APP"

  echo "--- Зависимости сервера"
  (cd server && npm ci --omit=dev --no-audit --no-fund --silent)

  # NODE_ENV=production заставляет npm пропускать devDependencies,
  # а сборщик (vite, tsc) живёт именно там — для сборки его снимаем.
  echo "--- Сборка админки"
  (cd admin && NODE_ENV=development npm ci --include=dev --no-audit --no-fund --silent && npm run build)

  echo "--- Сборка сайта"
  NODE_ENV=development npm ci --include=dev --no-audit --no-fund --silent
  # same-origin: сайт раздаёт этот же сервер, поэтому API зовётся относительным путём
  NODE_ENV=development VITE_API_URL=same-origin npm run build
  rm -rf server/public/site
  mkdir -p server/public
  cp -r dist server/public/site

  echo "--- Наполнение базы (только пустые таблицы)"
  npm --prefix server run seed --silent || true

  echo "--- Перезапуск"
  sudo /usr/bin/systemctl restart procomfort
  sleep 2

  # В sudoers разрешён ровно `systemctl is-active procomfort`, без флагов,
  # поэтому сравниваем вывод, а не полагаемся на --quiet.
  if [ "$(sudo /usr/bin/systemctl is-active procomfort)" = active ]; then
    echo "--- Готово: https://$DOMAIN"
  else
    echo "!!! Сервис не поднялся. Смотрите: journalctl -u procomfort -n 50"
    exit 1
  fi
done
