# Адрес API админки. Пусто — сайт работает на встроенных данных из src/data
# и складывает заявки в localStorage.
#
# ВАЖНО: для локальной разработки кладите это в .env.development.local,
# а не в .env.local — .env.local Vite читает и при продовой сборке,
# и адрес localhost уедет на боевой сайт.
VITE_API_URL=

# Куда слать заявки, если API админки не используется (например, PHP-скрипт)
VITE_LEAD_ENDPOINT=
