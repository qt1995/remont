# Порт API
PORT=4000

# Секрет для подписи сессионных кук. Обязательно поменять на проде:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Откуда разрешено ходить браузеру (через запятую, без слеша на конце)
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181

# На проде за nginx с https
TRUST_PROXY=0
COOKIE_SECURE=0
COOKIE_SAMESITE=lax

# Логин и пароль администратора создаются один раз при npm run seed
ADMIN_LOGIN=admin
ADMIN_PASSWORD=
